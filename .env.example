# LocalJobs Environment Configuration
APP_ENV=development
DATA_BACKEND=excel

# Optional PostgreSQL Database (leave commented/empty to use local Excel data/jobs.xlsx)
# DATABASE_URL=postgresql://localjobs:localjobs_secret_password@localhost:5432/localjobs_db

# LLM Configuration (Ollama)
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3

# Telephony Provider (Exotel)
EXOTEL_ACCOUNT_SID=
EXOTEL_API_KEY=
EXOTEL_API_TOKEN=
EXOTEL_EXOPHONE=

# Security Secrets
ADMIN_SECRET=localjobs_admin_secure_secret_token_12345
EMPLOYER_SECRET=localjobs_employer_secure_secret_token_67890

# Server & Storage Settings
HOST=0.0.0.0
PORT=8000
DATA_DIR=data
LOCALES_DIR=locales
