# LocalJobs Production Environment Configuration (Free Cloud Hosting)
APP_ENV=production
DEBUG=false

# Server Settings
HOST=0.0.0.0
PORT=8000

# Allowed CORS Origins (Include your Cloudflare Pages frontend URL)
ALLOWED_ORIGINS=https://localjobs.pages.dev,https://*.pages.dev,http://localhost:8000,*

# Optional: Local/Cloud LLM
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3

# Telephony Carrier Settings (Leave empty for Free Mock Demo Mode)
EXOTEL_ACCOUNT_SID=
EXOTEL_API_KEY=
EXOTEL_API_TOKEN=
EXOTEL_EXOPHONE=

# Administrative Security Secrets (Change to strong random tokens in production!)
ADMIN_SECRET=localjobs_production_admin_secret_token_replace_me
EMPLOYER_SECRET=localjobs_production_employer_secret_token_replace_me
