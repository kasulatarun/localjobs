# LocalJobs Production Environment Configuration (Free Cloud Hosting)
APP_ENV=production
DATA_BACKEND=postgres
DEBUG=false

# Production Database (Persistent ₹0 Tier on Supabase)
# Project Ref: opnyhmriwbtpqasgursq
# Replace [YOUR-PASSWORD] with the database password set when creating the Supabase project
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.opnyhmriwbtpqasgursq.supabase.co:5432/postgres
# Or if using Supabase Connection Pooler (port 6543 / 5432):
# DATABASE_URL=postgresql://postgres.opnyhmriwbtpqasgursq:[YOUR-PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?sslmode=require

# Server Settings
HOST=0.0.0.0
PORT=8000

# Allowed CORS Origins (Include your Cloudflare Pages frontend URL)
ALLOWED_ORIGINS=https://localjobs.pages.dev,https://*.pages.dev,http://localhost:8000,*

# Demo Helpline & WhatsApp Integration
DEMO_PHONE=+919848953136
WHATSAPP_PHONE=+919848953136
WHATSAPP_VERIFY_TOKEN=localjobs_whatsapp_verify_token

# Optional: Local/Cloud LLM
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3

# Telephony Carrier Settings (Leave empty for Free Mock / Demo Mode)
EXOTEL_ACCOUNT_SID=
EXOTEL_API_KEY=
EXOTEL_API_TOKEN=
EXOTEL_EXOPHONE=

# Administrative Security Secrets (Change to strong random tokens in production!)
ADMIN_SECRET=localjobs_production_admin_secret_token_replace_me
EMPLOYER_SECRET=localjobs_production_employer_secret_token_replace_me
